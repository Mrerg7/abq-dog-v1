---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page Not Found | ABQ.Dog"
  description="The page you requested could not be found. ABQ.Dog — premium Albuquerque dog domain for sale."
  canonical="https://abq.dog/404/"
  noindex={true}
>
  <Header />
  <main id="main" class="flex-1 bg-white">
    <div class="container-narrow max-w-2xl py-20 text-center sm:py-28">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sage-600">404</p>
      <h1 class="mt-2 font-display text-4xl font-semibold text-bark-950 sm:text-5xl">That trail went cold</h1>
      <p class="mt-4 text-base text-bark-700 sm:text-lg">
        The page you're looking for doesn't exist — but ABQ.Dog itself is still available.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn-primary">Back to ABQ.Dog</a>
        <a href="/insights/" class="btn-ghost">Browse insights</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
