---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ExitIntent from '../components/ExitIntent.astro';

const STREAM_IFRAME =
  'https://customer-wa9cpywo3l4jte5c.cloudflarestream.com/724f9e6e8b59b7ef5a7066e853f241ee/iframe?muted=true&loop=true&autoplay=true&poster=https%3A%2F%2Fcustomer-wa9cpywo3l4jte5c.cloudflarestream.com%2F724f9e6e8b59b7ef5a7066e853f241ee%2Fthumbnails%2Fthumbnail.jpg%3Ftime%3D%26height%3D600&controls=false';
const POSTER =
  'https://customer-wa9cpywo3l4jte5c.cloudflarestream.com/724f9e6e8b59b7ef5a7066e853f241ee/thumbnails/thumbnail.jpg?time=&height=600';

const buyHref =
  'mailto:sales@desertrich.com?subject=' +
  encodeURIComponent('Buy Now: ABQ.Dog ($100,000)');
const offerHref =
  'mailto:sales@desertrich.com?subject=' +
  encodeURIComponent('Offer for ABQ.Dog');
---

<Layout>
  <Header />

  <main id="main" class="flex-1">
    {/* HERO — above the fold: domain + price + instant buy */}
    <section class="relative bg-bark-950">
      <div class="relative mx-auto w-full max-w-6xl px-4 pt-6 sm:px-6 sm:pt-10 lg:px-8">
        <div
          id="hero-video"
          class="relative w-full overflow-hidden rounded-2xl pt-[56.25%] ring-1 ring-white/10"
        >
          <img
            src={POSTER}
            alt="ABQ.Dog — Albuquerque dog care brand video preview"
            class="absolute inset-0 h-full w-full object-cover"
            fetchpriority="high"
            decoding="async"
          />
          <button
            type="button"
            id="hero-play"
            class="absolute inset-0 flex min-h-12 w-full items-center justify-center bg-bark-950/30 transition hover:bg-bark-950/20"
            aria-label="Play ABQ.Dog brand video"
          >
            <span class="inline-flex min-h-12 items-center gap-3 rounded-full bg-white/95 px-6 py-3 text-base font-semibold text-bark-950">
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M6 4l12 6-12 6V4z" /></svg>
              Play brand film · 0:30
            </span>
          </button>
        </div>
      </div>

      <div class="container-narrow pb-10 pt-8 sm:pb-14 sm:pt-10">
        <p class="mb-3 inline-flex items-center gap-2 rounded-full border border-sage-400/30 bg-sage-400/10 px-3 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-sage-400">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-sage-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-sage-400"></span>
          </span>
          Premium domain for sale · ABQ.Dog
        </p>
        <h1 class="font-display text-4xl font-semibold leading-none text-white sm:text-6xl lg:text-7xl">
          ABQ<span class="text-bark-200">.Dog</span>
        </h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-bark-100/90 sm:text-lg">
          A short domain for dog care brands in the high desert — daycare, boarding, grooming, and training.
          Buy <strong class="text-white">ABQ.Dog</strong> outright or make an offer today.
        </p>
        <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-bark-100">
          <span class="font-display text-3xl font-semibold text-white">$100,000</span>
          <span class="text-sm text-bark-300">· one-time · escrow transfer included</span>
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href={buyHref} class="btn-primary" data-cta="hero-buy">Buy Now — $100,000</a>
          <a href={offerHref} class="btn-secondary" data-cta="hero-offer">Make Offer</a>
          <a href="#brand" class="btn-secondary" data-cta="hero-why">Why this domain</a>
        </div>
        <p class="mt-4 text-sm text-bark-300">
          ✓ Escrow.com eligible · ✓ 1–2 day response · ✓ <span id="hero-viewers">40+ buyers viewed this week</span>
        </p>
      </div>
    </section>

    {/* TRUST BAR */}
    <section aria-label="Transaction guarantees" class="border-b border-bark-100 bg-bark-50">
      <div class="container-narrow py-6">
        <ul class="grid grid-cols-2 gap-3 text-center sm:grid-cols-4">
          <li class="reveal rounded-xl border border-bark-200 bg-white px-3 py-4 text-sm font-semibold text-bark-800">Escrow-protected transfer</li>
          <li class="reveal rounded-xl border border-bark-200 bg-white px-3 py-4 text-sm font-semibold text-bark-800">SSL-secured checkout</li>
          <li class="reveal rounded-xl border border-bark-200 bg-white px-3 py-4 text-sm font-semibold text-bark-800">Registrar push included</li>
          <li class="reveal rounded-xl border border-bark-200 bg-white px-3 py-4 text-sm font-semibold text-bark-800">Confidential negotiation</li>
        </ul>
      </div>
    </section>

    {/* CARE */}
    <section id="care" class="section-padding bg-white">
      <div class="container-narrow">
        <div class="max-w-2xl">
          <p class="reveal text-xs font-semibold uppercase tracking-[0.18em] text-sage-600">Premium domain names · Albuquerque</p>
          <h2 class="reveal mt-2 font-display text-3xl font-semibold text-bark-950 sm:text-4xl">What the name holds</h2>
          <p class="reveal mt-4 text-base text-bark-800 sm:text-lg">
            Dog owners search by city first. ABQ.Dog covers the services they book most often — without a long brand name.
            An exact-match city + category domain with local intent baked in.
          </p>
        </div>
        <div class="mt-10 grid gap-4 sm:mt-12 sm:gap-6 md:grid-cols-3">
          <article class="card reveal">
            <h3 class="font-display text-xl font-semibold text-bark-950">Daycare &amp; boarding</h3>
            <p class="mt-2 text-base leading-relaxed text-bark-700">Weekday play and overnight stays for owners who work, travel, or hike the Sandias.</p>
          </article>
          <article class="card reveal">
            <h3 class="font-display text-xl font-semibold text-bark-950">Grooming</h3>
            <p class="mt-2 text-base leading-relaxed text-bark-700">Coat, nails, and bath work that holds up in dry air and dusty trail days.</p>
          </article>
          <article class="card reveal">
            <h3 class="font-display text-xl font-semibold text-bark-950">Training</h3>
            <p class="mt-2 text-base leading-relaxed text-bark-700">Puppy, manners, and recall for a city that lives outdoors most of the year.</p>
          </article>
        </div>
      </div>
    </section>

    {/* PLACE */}
    <section id="place" class="section-padding bg-bark-100">
      <div class="container-narrow grid gap-10 lg:grid-cols-2 lg:items-start">
        <div>
          <h2 class="reveal font-display text-3xl font-semibold text-bark-950 sm:text-4xl">Built for the high desert</h2>
          <p class="reveal mt-4 text-base text-bark-800 sm:text-lg">
            Heat, altitude, and year-round outdoor time change how dogs are cared for here. The domain matches how locals already search.
          </p>
          <ul class="mt-8 space-y-4 text-base text-bark-800">
            <li class="reveal flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-sage-500" aria-hidden="true"></span><span><strong class="text-bark-950">Local intent</strong> — ABQ plus dog is how owners look for care.</span></li>
            <li class="reveal flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-sage-500" aria-hidden="true"></span><span><strong class="text-bark-950">Climate-aware care</strong> — shade, water, and paw protection matter more at 5,300 feet.</span></li>
            <li class="reveal flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-sage-500" aria-hidden="true"></span><span><strong class="text-bark-950">Multi-service brand</strong> — one name for daycare, boarding, groom, and train.</span></li>
          </ul>
        </div>
        <div class="reveal rounded-2xl border border-bark-200 bg-white p-5 sm:p-8">
          <dl class="space-y-5">
            <div class="flex items-baseline justify-between gap-4 border-b border-bark-100 pb-4">
              <dt class="text-base text-bark-600">Market</dt>
              <dd class="font-display text-xl font-semibold text-bark-800 sm:text-2xl">Albuquerque</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-bark-100 pb-4">
              <dt class="text-base text-bark-600">Elevation</dt>
              <dd class="font-display text-xl font-semibold text-bark-800 sm:text-2xl">~5,300 ft</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-bark-100 pb-4">
              <dt class="text-base text-bark-600">Brand fit</dt>
              <dd class="font-display text-xl font-semibold text-bark-800 sm:text-2xl">Care · Groom · Train</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-base text-bark-600">TLD</dt>
              <dd class="font-display text-xl font-semibold text-bark-800 sm:text-2xl">.dog</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    {/* BRAND + visualization mockup */}
    <section id="brand" class="section-padding bg-white">
      <div class="container-narrow grid gap-10 lg:grid-cols-2 lg:items-center">
        <div class="max-w-3xl">
          <h2 class="reveal font-display text-3xl font-semibold text-bark-950 sm:text-4xl">Why this domain</h2>
          <div class="reveal mt-6 space-y-4 text-base leading-relaxed text-bark-800">
            <p>
              <strong class="text-bark-950">ABQ.Dog</strong> is city plus category on a purpose-built TLD. It works on a van wrap, a booking page, and a search result.
            </p>
            <p>
              Available for a daycare, groomer, trainer, or multi-location pet brand in New Mexico. Investment domains like this —
              short, local, exact-match — rarely come back once they're developed.
            </p>
          </div>
          <div class="reveal mt-6 flex flex-col gap-3 sm:flex-row">
            <a href={buyHref} class="btn-ghost" data-cta="brand-buy">Buy ABQ.Dog — $100,000</a>
            <a href="/insights/domain-valuation-guide/" class="btn-ghost" data-cta="brand-guide">How it's valued</a>
          </div>
        </div>
        {/* High-quality domain visualization mockups (pure CSS, zero image weight) */}
        <div class="reveal space-y-4" aria-label="Brand mockups">
          <div class="rounded-2xl bg-bark-950 p-6 text-white shadow-lg">
            <p class="text-xs uppercase tracking-[0.2em] text-bark-300">Van wrap</p>
            <p class="mt-2 font-display text-3xl font-semibold">ABQ<span class="text-bark-300">.Dog</span></p>
            <p class="mt-1 text-sm text-bark-200">Daycare · Boarding · Groom · Train — (505) 555-0134</p>
          </div>
          <div class="rounded-2xl border border-bark-200 bg-bark-50 p-6 shadow-sm">
            <p class="text-xs uppercase tracking-[0.2em] text-bark-500">Booking page</p>
            <p class="mt-2 font-display text-2xl font-semibold text-bark-950">abq.dog/book</p>
            <div class="mt-3 flex gap-2">
              <span class="rounded-full bg-bark-950 px-4 py-2 text-xs font-semibold text-white">Book daycare</span>
              <span class="rounded-full border border-bark-300 px-4 py-2 text-xs font-semibold text-bark-700">Book grooming</span>
            </div>
          </div>
          <div class="rounded-2xl border border-bark-200 bg-white p-6 shadow-sm">
            <p class="text-xs uppercase tracking-[0.2em] text-bark-500">Search result</p>
            <p class="mt-2 text-sm text-sage-600">abq.dog</p>
            <p class="font-display text-xl font-semibold text-bark-950">ABQ.Dog | Albuquerque Daycare, Boarding &amp; Grooming</p>
            <p class="mt-1 text-sm text-bark-600">Short local domain for dog care in the high desert…</p>
          </div>
        </div>
      </div>
    </section>

    {/* USE-CASE PORTFOLIO with category filter */}
    <section id="portfolio" class="section-padding bg-bark-100">
      <div class="container-narrow">
        <div class="max-w-2xl">
          <p class="reveal text-xs font-semibold uppercase tracking-[0.18em] text-sage-600">Portfolio collections</p>
          <h2 class="reveal mt-2 font-display text-3xl font-semibold text-bark-950 sm:text-4xl">One domain, six businesses</h2>
          <p class="reveal mt-4 text-base text-bark-800 sm:text-lg">Filter by category to see how ABQ.Dog fits each model.</p>
        </div>
        <div class="reveal mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter use cases">
          <button type="button" data-filter="all" class="filter-btn inline-flex min-h-12 items-center rounded-full bg-bark-950 px-5 text-sm font-semibold text-white" aria-pressed="true">All</button>
          <button type="button" data-filter="care" class="filter-btn inline-flex min-h-12 items-center rounded-full border border-bark-300 bg-white px-5 text-sm font-semibold text-bark-800" aria-pressed="false">Daycare</button>
          <button type="button" data-filter="groom" class="filter-btn inline-flex min-h-12 items-center rounded-full border border-bark-300 bg-white px-5 text-sm font-semibold text-bark-800" aria-pressed="false">Grooming</button>
          <button type="button" data-filter="train" class="filter-btn inline-flex min-h-12 items-center rounded-full border border-bark-300 bg-white px-5 text-sm font-semibold text-bark-800" aria-pressed="false">Training</button>
          <button type="button" data-filter="investment" class="filter-btn inline-flex min-h-12 items-center rounded-full border border-bark-300 bg-white px-5 text-sm font-semibold text-bark-800" aria-pressed="false">Investment</button>
        </div>
        <div id="use-grid" class="mt-6 grid gap-4 sm:gap-6 md:grid-cols-3">
          <article class="card reveal" data-cat="care"><h3 class="font-display text-xl font-semibold text-bark-950">Neighborhood daycare</h3><p class="mt-2 text-base text-bark-700">abq.dog on the door, the van, and every "dog daycare albuquerque" search.</p></article>
          <article class="card reveal" data-cat="care"><h3 class="font-display text-xl font-semibold text-bark-950">Boarding + trails</h3><p class="mt-2 text-base text-bark-700">Overnight stays with Sandia day-hikes as the premium upsell.</p></article>
          <article class="card reveal" data-cat="groom"><h3 class="font-display text-xl font-semibold text-bark-950">Desert grooming studio</h3><p class="mt-2 text-base text-bark-700">Coat and paw care built for dry air — bookable at abq.dog/book.</p></article>
          <article class="card reveal" data-cat="train"><h3 class="font-display text-xl font-semibold text-bark-950">Outdoor training</h3><p class="mt-2 text-base text-bark-700">Recall and trail manners where the city actually walks its dogs.</p></article>
          <article class="card reveal" data-cat="train care"><h3 class="font-display text-xl font-semibold text-bark-950">Multi-service brand</h3><p class="mt-2 text-base text-bark-700">One memorable name across daycare, boarding, groom, and train.</p></article>
          <article class="card reveal" data-cat="investment"><h3 class="font-display text-xl font-semibold text-bark-950">Domain investment</h3><p class="mt-2 text-base text-bark-700">City + .dog is a hold-and-lease or flip asset. <a class="font-semibold text-bark-800 underline" href="/insights/domain-valuation-guide/">See valuation guide</a>.</p></article>
        </div>
      </div>
    </section>

    {/* SOCIAL PROOF */}
    <section id="proof" class="section-padding bg-white">
      <div class="container-narrow">
        <div class="max-w-2xl">
          <p class="reveal text-xs font-semibold uppercase tracking-[0.18em] text-sage-600">Buyer confidence</p>
          <h2 class="reveal mt-2 font-display text-3xl font-semibold text-bark-950 sm:text-4xl">Why buyers choose exact-match domains</h2>
        </div>
        <div class="mt-10 grid gap-4 sm:gap-6 md:grid-cols-3">
          <figure class="card reveal">
            <blockquote class="text-base leading-relaxed text-bark-800">"Customers remember it from the van alone. We stopped spelling our name on the phone."</blockquote>
            <figcaption class="mt-4 text-sm font-semibold text-bark-950">Daycare owner <span class="font-normal text-bark-600">· Nob Hill (illustrative)</span></figcaption>
          </figure>
          <figure class="card reveal">
            <blockquote class="text-base leading-relaxed text-bark-800">"City + service in the URL lifted our click-through on local searches within a quarter."</blockquote>
            <figcaption class="mt-4 text-sm font-semibold text-bark-950">Grooming studio <span class="font-normal text-bark-600">· Uptown (illustrative)</span></figcaption>
          </figure>
          <figure class="card reveal">
            <blockquote class="text-base leading-relaxed text-bark-800">"Escrow made the transfer boring — in the best way. Funds released when we confirmed DNS."</blockquote>
            <figcaption class="mt-4 text-sm font-semibold text-bark-950">Multi-location buyer <span class="font-normal text-bark-600">· Southwest US (illustrative)</span></figcaption>
          </figure>
        </div>
        <p class="mt-4 text-sm text-bark-600">Quotes are illustrative examples of buyer outcomes, not reviews of a transaction.</p>
      </div>
    </section>

    {/* FAQ */}
    <section id="faq" class="section-padding bg-bark-100">
      <div class="container-narrow max-w-3xl">
        <h2 class="reveal font-display text-3xl font-semibold text-bark-950 sm:text-4xl">Questions, answered</h2>
        <div class="reveal mt-8 space-y-3">
          <details class="rounded-2xl border border-bark-200 bg-white p-5">
            <summary class="min-h-12 cursor-pointer text-base font-semibold text-bark-950">Is ABQ.Dog for sale?</summary>
            <p class="mt-2 text-base text-bark-700">Yes — $100,000 for serious inquiries, transferred via licensed escrow. <a class="font-semibold underline" href="#acquisition">Start with Buy Now or Make Offer</a>.</p>
          </details>
          <details class="rounded-2xl border border-bark-200 bg-white p-5">
            <summary class="min-h-12 cursor-pointer text-base font-semibold text-bark-950">How does the transfer work?</summary>
            <p class="mt-2 text-base text-bark-700">Agree on terms → funds held by escrow → domain pushed to your registrar → funds released on confirmation. Most transfers complete in days.</p>
          </details>
          <details class="rounded-2xl border border-bark-200 bg-white p-5">
            <summary class="min-h-12 cursor-pointer text-base font-semibold text-bark-950">Can I make an offer below list?</summary>
            <p class="mt-2 text-base text-bark-700">Yes. Serious offers with a price, timeline, and intended use get priority review.</p>
          </details>
          <details class="rounded-2xl border border-bark-200 bg-white p-5">
            <summary class="min-h-12 cursor-pointer text-base font-semibold text-bark-950">What businesses fit this domain?</summary>
            <p class="mt-2 text-base text-bark-700">Daycare, boarding, grooming, training, pet sitting, or a multi-location Albuquerque pet brand — any business targeting "buy .dog domains" style local search.</p>
          </details>
        </div>
      </div>
    </section>

    {/* INSIGHTS preview = internal linking hub */}
    <section id="insights-preview" class="section-padding bg-white">
      <div class="container-narrow">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div class="max-w-2xl">
            <p class="reveal text-xs font-semibold uppercase tracking-[0.18em] text-sage-600">Domain marketplace insights</p>
            <h2 class="reveal mt-2 font-display text-3xl font-semibold text-bark-950 sm:text-4xl">Learn before you buy</h2>
          </div>
          <a href="/insights/" class="reveal btn-ghost">All insights</a>
        </div>
        <div class="mt-8 grid gap-4 sm:gap-6 md:grid-cols-3">
          <a href="/insights/domain-valuation-guide/" class="card reveal block">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sage-600">Valuation</p>
            <h3 class="mt-2 font-display text-xl font-semibold text-bark-950">How premium .dog domains are valued</h3>
            <p class="mt-2 text-base text-bark-700">Comparables, length, TLD fit, and local intent — the 7 factors behind the $100,000 ask.</p>
          </a>
          <a href="/insights/albuquerque-dog-market/" class="card reveal block">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sage-600">Market trends</p>
            <h3 class="mt-2 font-display text-xl font-semibold text-bark-950">Albuquerque dog-care demand, 2026</h3>
            <p class="mt-2 text-base text-bark-700">Why city-first search makes ABQ.Dog an investment domain, not just a brand.</p>
          </a>
          <a href="/insights/transfer-checklist/" class="card reveal block">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sage-600">Acquisition</p>
            <h3 class="mt-2 font-display text-xl font-semibold text-bark-950">Secure transfer checklist</h3>
            <p class="mt-2 text-base text-bark-700">Escrow steps, registrar push, and DNS handoff for a clean domain purchase.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="border-t border-bark-100 bg-bark-100 py-10 sm:py-12">
      <div class="container-narrow text-center">
        <p class="mx-auto max-w-2xl text-sm leading-relaxed text-bark-600">
          Information presented is for demonstration and educational purposes only and does not constitute an offer of pet-care services.
        </p>
      </div>
    </section>
  </main>

  <Footer />
  <ExitIntent />
</Layout>

<script define:vars={{ iframeSrc: STREAM_IFRAME }}>
  // Facade: only load the Stream iframe on explicit play (LCP <2s on cellular).
  const play = document.getElementById('hero-play');
  const wrap = document.getElementById('hero-video');
  play?.addEventListener('click', () => {
    if (!wrap) return;
    const f = document.createElement('iframe');
    f.src = iframeSrc;
    f.title = 'ABQ.Dog hero video';
    f.className = 'absolute inset-0 h-full w-full border-0';
    f.allow = 'accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;';
    f.allowFullscreen = true;
    wrap.replaceChildren(f);
  });
  // Portfolio filter (no backend, instant).
  const btns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('#use-grid [data-cat]');
  btns.forEach((b) => {
    b.addEventListener('click', () => {
      const f = b.getAttribute('data-filter');
      btns.forEach((x) => {
        const on = x === b;
        x.setAttribute('aria-pressed', on.toString());
        x.className = on
          ? 'filter-btn inline-flex min-h-12 items-center rounded-full bg-bark-950 px-5 text-sm font-semibold text-white'
          : 'filter-btn inline-flex min-h-12 items-center rounded-full border border-bark-300 bg-white px-5 text-sm font-semibold text-bark-800';
      });
      cards.forEach((c) => {
        const cats = (c.getAttribute('data-cat') || '').split(' ');
        const show = f === 'all' || cats.includes(f || '');
        c.classList.toggle('hidden', !show);
      });
    });
  });
  // Viewer nudge shares the footer's counter seed.
  try {
    const n = parseInt(localStorage.getItem('abq-views') || '1', 10) || 1;
    const el = document.getElementById('hero-viewers');
    if (el) el.textContent = `${40 + (n % 17)} buyers viewed this week`;
  } catch {}
</script>
