---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Domain Insights | Premium .Dog Domains & Market Guides | ABQ.Dog"
  description="Valuation guides, Albuquerque dog-care market trends, and secure transfer checklists for premium domain names. From the ABQ.Dog domain marketplace."
  canonical="https://abq.dog/insights/"
>
  <Header />
  <main id="main" class="flex-1">
    <section class="bg-bark-950">
      <div class="container-narrow py-12 sm:py-16">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sage-400">ABQ.Dog · Insights</p>
        <h1 class="mt-2 font-display text-4xl font-semibold text-white sm:text-5xl">Domain insights</h1>
        <p class="mt-4 max-w-2xl text-base text-bark-100/90 sm:text-lg">
          Valuation guides, market trends, and acquisition checklists for premium domain names and investment domains. Updated weekly.
        </p>
      </div>
    </section>
    <section class="section-padding bg-white">
      <div class="container-narrow">
        <div class="grid gap-4 sm:gap-6 md:grid-cols-3">
          {
            posts.map((post) => (
              <a href={`/insights/${post.slug}/`} class="card block">
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sage-600">
                  {(post.data.tags[0] || 'Guide').replace(/-/g, ' ')}
                </p>
                <h2 class="mt-2 font-display text-xl font-semibold text-bark-950">{post.data.title}</h2>
                <p class="mt-2 text-base text-bark-700">{post.data.description}</p>
                <p class="mt-4 text-sm text-bark-500">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                </p>
              </a>
            ))
          }
        </div>
        <div class="mt-10 rounded-2xl bg-bark-100 p-6 text-center sm:p-8">
          <h2 class="font-display text-2xl font-semibold text-bark-950">Want the full acquisition brief?</h2>
          <p class="mt-2 text-base text-bark-700">Price, escrow steps, and first refusal if an offer lands.</p>
          <a href="/#acquisition" class="btn-primary mt-5">Inquire about ABQ.Dog</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
