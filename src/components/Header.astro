---
---

<header class="sticky top-0 z-50 border-b border-bark-100/80 bg-bark-50/90 backdrop-blur-md">
  <div class="container-narrow">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="flex min-h-12 items-center gap-2" aria-label="ABQ.Dog home">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-bark-950 text-sage-400">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13c0-2 1.5-4 3.5-4S12 11 12 13h2c0-2 1.5-4 3.5-4S21 11 21 13v5a3 3 0 01-3 3H8a3 3 0 01-3-3v-5z" />
          </svg>
        </span>
        <span class="leading-tight">
          <span class="font-display text-xl font-semibold text-bark-950">ABQ</span>
          <span class="ml-1 text-xs font-semibold uppercase tracking-[0.16em] text-bark-600">Dog</span>
        </span>
      </a>

      <nav class="hidden items-center gap-6 md:flex" aria-label="Main navigation">
        <a href="/#care" class="inline-flex min-h-12 items-center text-base font-medium text-bark-800 hover:text-bark-600">Care</a>
        <a href="/#place" class="inline-flex min-h-12 items-center text-base font-medium text-bark-800 hover:text-bark-600">The City</a>
        <a href="/#brand" class="inline-flex min-h-12 items-center text-base font-medium text-bark-800 hover:text-bark-600">The Domain</a>
        <a href="/insights/" class="inline-flex min-h-12 items-center text-base font-medium text-bark-800 hover:text-bark-600">Insights</a>
        <a href="/#acquisition" class="inline-flex min-h-12 items-center rounded-full bg-bark-700 px-5 text-sm font-semibold text-white hover:bg-bark-600">Domain Inquiry</a>
        <button type="button" id="theme-toggle" class="inline-flex h-12 w-12 items-center justify-center rounded-full text-bark-800 hover:bg-bark-100" aria-label="Toggle dark mode" aria-pressed="false">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z" />
          </svg>
        </button>
      </nav>

      <div class="flex items-center gap-1 md:hidden">
        <button type="button" id="theme-toggle-mobile" class="inline-flex h-12 w-12 items-center justify-center rounded-lg text-bark-800 hover:bg-bark-100" aria-label="Toggle dark mode" aria-pressed="false">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z" />
          </svg>
        </button>
        <button type="button" id="mobile-menu-btn" class="inline-flex h-12 w-12 items-center justify-center rounded-lg text-bark-800 hover:bg-bark-100" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle menu">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-bark-100 bg-bark-50 md:hidden">
    <nav class="container-narrow space-y-1 py-3" aria-label="Mobile navigation">
      <a href="/#care" class="flex min-h-12 items-center rounded-lg px-3 text-base font-medium text-bark-900">Care</a>
      <a href="/#place" class="flex min-h-12 items-center rounded-lg px-3 text-base font-medium text-bark-900">The City</a>
      <a href="/#brand" class="flex min-h-12 items-center rounded-lg px-3 text-base font-medium text-bark-900">The Domain</a>
      <a href="/insights/" class="flex min-h-12 items-center rounded-lg px-3 text-base font-medium text-bark-900">Insights</a>
      <a href="/#acquisition" class="mt-2 flex min-h-12 items-center justify-center rounded-full bg-bark-700 px-4 text-center text-base font-semibold text-white">Domain Inquiry</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', (!isOpen).toString());
    });
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }
  // Dark/light toggle (free-plan: localStorage only, no backend)
  const applyTheme = (dark) => {
    document.documentElement.classList.toggle('dark', dark);
    ['theme-toggle', 'theme-toggle-mobile'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.setAttribute('aria-pressed', dark.toString());
    });
    try { localStorage.setItem('abq-theme', dark ? 'dark' : 'light'); } catch {}
  };
  let initial = false;
  try {
    const saved = localStorage.getItem('abq-theme');
    initial = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
  } catch {}
  applyTheme(initial);
  ['theme-toggle', 'theme-toggle-mobile'].forEach((id) => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('click', () => applyTheme(!document.documentElement.classList.contains('dark')));
  });
  // Scroll reveal
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
