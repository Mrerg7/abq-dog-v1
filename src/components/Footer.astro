---
const currentYear = new Date().getFullYear();
const offerSubject = encodeURIComponent('Offer for ABQ.Dog');
const buySubject = encodeURIComponent('Buy Now: ABQ.Dog ($100,000)');
const agentSubject = encodeURIComponent('Domain Inquiry: ABQ.Dog');
---

<footer id="acquisition" class="bg-bark-950 text-bark-50">
  <div class="border-b border-white/10">
    <div class="container-narrow py-12 sm:py-16">
      <div class="mx-auto max-w-2xl text-center">
        <div class="reveal mb-4 inline-flex items-center gap-2 rounded-full border border-sage-400/30 bg-sage-400/10 px-3 py-2 text-xs font-semibold uppercase tracking-wider text-sage-400">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-sage-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-sage-400"></span>
          </span>
          Domain Available · 1 of 1
        </div>
        <h2 class="reveal font-display text-3xl font-semibold text-white sm:text-4xl">
          Acquire <span class="text-bark-200">ABQ.Dog</span>
        </h2>
        <p class="reveal mt-4 text-base leading-relaxed text-bark-200">
          Short city + category domain for daycare, boarding, grooming, training, or a multi-service dog brand in Albuquerque.
        </p>
        <p class="reveal mt-3 text-sm text-bark-300">
          <span class="font-display text-2xl font-semibold text-white">$100,000</span>
          <span class="mx-2 text-bark-500" aria-hidden="true">·</span>
          <span id="viewer-count">Serious inquiries only</span>
        </p>

        <!-- Tiered CTAs: Buy Now / Make Offer / Contact Agent -->
        <div class="reveal mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row">
          <a
            href={`mailto:sales@desertrich.com?subject=${buySubject}&body=${encodeURIComponent('I would like to acquire ABQ.Dog at the listed price. Please send escrow instructions.\n\nName:\nTimeline:')}`}
            class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-bark-500 px-6 py-3 text-base font-semibold text-white hover:bg-bark-400 sm:w-auto"
            data-cta="buy-now"
          >Buy Now — $100,000</a>
          <a
            href={`mailto:sales@desertrich.com?subject=${offerSubject}&body=${encodeURIComponent('My offer for ABQ.Dog:\n\nOffer amount (USD):\nTimeline:\nIntended use:')}`}
            class="inline-flex min-h-12 w-full items-center justify-center rounded-full border border-white/30 bg-white/10 px-6 py-3 text-base font-semibold text-white hover:bg-white/20 sm:w-auto"
            data-cta="make-offer"
          >Make Offer</a>
          <a
            href={`mailto:sales@desertrich.com?subject=${agentSubject}`}
            class="inline-flex min-h-12 w-full items-center justify-center rounded-full border border-white/20 px-6 py-3 text-base font-semibold text-bark-100 hover:bg-white/10 sm:w-auto"
            data-cta="contact-agent"
          >Contact Agent</a>
        </div>
        <p class="mt-5 text-sm text-bark-400">Confidential. Response within 1–2 business days. Secure transfer via licensed escrow.</p>

        <!-- Trust signals -->
        <ul class="mt-8 flex flex-wrap items-center justify-center gap-2 text-xs font-medium text-bark-300" aria-label="Transaction guarantees">
          <li class="inline-flex min-h-12 items-center gap-2 rounded-full border border-white/15 px-4 py-2">✓ Escrow.com eligible</li>
          <li class="inline-flex min-h-12 items-center gap-2 rounded-full border border-white/15 px-4 py-2">✓ SSL-secured transfer</li>
          <li class="inline-flex min-h-12 items-center gap-2 rounded-full border border-white/15 px-4 py-2">✓ Registrar push included</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="container-narrow py-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="text-base font-medium text-white">ABQ.Dog</p>
        <p class="mt-1 text-sm text-bark-400">Informational platform · Albuquerque, NM</p>
        <nav class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label="Footer">
          <a href="/#care" class="inline-flex min-h-12 items-center text-bark-300 hover:text-white">Care</a>
          <a href="/#brand" class="inline-flex min-h-12 items-center text-bark-300 hover:text-white">The Domain</a>
          <a href="/insights/" class="inline-flex min-h-12 items-center text-bark-300 hover:text-white">Insights</a>
          <a href="/sitemap-index.xml" class="inline-flex min-h-12 items-center text-bark-300 hover:text-white">Sitemap</a>
        </nav>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-bark-400 sm:text-right">
        This website is for demonstration and informational purposes only. It does not constitute an offer of services,
        a commitment to deploy, or a guarantee of outcomes. All statistics, projections, and references to specific
        technologies are based on publicly available information as of the date shown and are subject to change.
      </p>
    </div>
    <div class="mt-8 flex flex-col gap-2 border-t border-white/10 pt-6 text-sm text-bark-500 sm:flex-row sm:justify-between">
      <p>© {currentYear} ABQ.Dog. All rights reserved.</p>
      <p>Astro · Cloudflare Workers Static Assets · Stream</p>
    </div>
  </div>
</footer>

<script>
  // Lightweight viewing counter (social-proof nudge, localStorage only — free plan, no backend).
  try {
    const key = 'abq-views';
    const n = (parseInt(localStorage.getItem(key) || '0', 10) || 0) + 1;
    localStorage.setItem(key, String(n));
    const base = 40 + (n % 17);
    const el = document.getElementById('viewer-count');
    if (el) el.textContent = `${base} buyers viewed this domain this week · Serious inquiries only`;
  } catch {}
  // CTA click tracking hook (wires to any analytics pixel added later).
  document.querySelectorAll('[data-cta]').forEach((a) => {
    a.addEventListener('click', () => {
      try { (window).dataLayer?.push({ event: 'cta_click', cta: a.getAttribute('data-cta') }); } catch {}
    });
  });
</script>
